    serverHopBtn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)

    task.spawn(function()
        local success, err = pcall(function()
            local cursor = ""
            local foundServer = false
            
            while not foundServer do
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                if cursor ~= "" then
                    url = url .. "&cursor=" .. cursor
                end
                
                local response = HttpService:JSONDecode(game:HttpGet(url))
                if response and response.data then
                    for _, srv in ipairs(response.data) do
                        if srv.playing and srv.playing >= 1 and srv.playing <= 3 and srv.id ~= game.JobId and not srv.privateServerId then
                            foundServer = true
                            serverHopBtn.Text = "กำลังพาไปยังเซิร์ฟ (" .. srv.playing .. " คน)..."
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, player)
                            break
                        end
                    end
                    
                    if foundServer then break end
                    
                    if response.nextPageCursor then
                        cursor = response.nextPageCursor
                    else
                        cursor = ""
                        task.wait(1)
                    end
                else
                    task.wait(2)
                end
            end
        end)

        if not success then
            serverHopBtn.Text = "เกิดข้อผิดพลาด ลองใหม่อีกครั้ง"
            serverHopBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
