-- ฟังก์ชันสำหรับปรับขนาดหน้าต่างด้วยการกดค้างที่มุม
local function makeResizable(frame, minSize, maxSize)
    local corners = {"TopLeft", "TopRight", "BottomLeft", "BottomRight"}
    
    for _, cornerName in ipairs(corners) do
        local handle = Instance.new("TextButton")
        handle.Name = cornerName .. "Handle"
        handle.Size = UDim2.new(0, 16, 0, 16)
        handle.BackgroundTransparency = 1
        handle.Text = ""
        handle.ZIndex = 10
        handle.Parent = frame
        
        if cornerName == "TopLeft" then
            handle.Position = UDim2.new(0, -4, 0, -4)
        elseif cornerName == "TopRight" then
            handle.Position = UDim2.new(1, -12, 0, -4)
        elseif cornerName == "BottomLeft" then
            handle.Position = UDim2.new(0, -4, 1, -12)
        elseif cornerName == "BottomRight" then
            handle.Position = UDim2.new(1, -12, 1, -12)
        end
        
        local resizing = false
        local startInputPos, startSize, startPos
        
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                startInputPos = input.Position
                startSize = frame.AbsoluteSize
                startPos = frame.AbsolutePosition
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - startInputPos
                local newWidth, newHeight, newX, newY = startSize.X, startSize.Y, startPos.X, startPos.Y
                
                if cornerName == "BottomRight" then
                    newWidth = math.clamp(startSize.X + delta.X, minSize.X, maxSize.X)
                    newHeight = math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
                elseif cornerName == "BottomLeft" then
                    newWidth = math.clamp(startSize.X - delta.X, minSize.X, maxSize.X)
                    newHeight = math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
                    newX = startPos.X + (startSize.X - newWidth)
                elseif cornerName == "TopRight" then
                    newWidth = math.clamp(startSize.X + delta.X, minSize.X, maxSize.X)
                    newHeight = math.clamp(startSize.Y - delta.Y, minSize.Y, maxSize.Y)
                    newY = startPos.Y + (startSize.Y - newHeight)
                elseif cornerName == "TopLeft" then
                    newWidth = math.clamp(startSize.X - delta.X, minSize.X, maxSize.X)
                    newHeight = math.clamp(startSize.Y - delta.Y, minSize.Y, maxSize.Y)
                    newX = startPos.X + (startSize.X - newWidth)
                    newY = startPos.Y + (startSize.Y - newHeight)
                end
                
                frame.Size = UDim2.new(0, newWidth, 0, newHeight)
                frame.Position = UDim2.new(0, newX, 0, newY)
            end
        end)
    end
end

